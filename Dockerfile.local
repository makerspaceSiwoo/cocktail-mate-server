FROM python:3.12-slim

WORKDIR /app

# 로컬 개발에서는 아직 커밋/태그하지 않은 canonical DB 모델도 즉시 검증할 수
# 있도록 monorepo의 인접 cocktail-mate-db 소스를 직접 설치한다.
COPY requirements-base.txt .
COPY --from=cocktail_mate_db . /tmp/cocktail-mate-db
RUN pip install --no-cache-dir -r requirements-base.txt /tmp/cocktail-mate-db

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
